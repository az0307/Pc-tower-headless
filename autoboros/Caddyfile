# ═══════════════════════════════════════════════════════════════
#  AUTOBOROS Caddyfile v3.0
#  All routes for core + optional apps
# ═══════════════════════════════════════════════════════════════

:80 {
    respond "AUTOBOROS Gateway — Unauthorized"
}

# --- Tier 0: Core ---
beszel.{$TAILSCALE_DOMAIN} {
    reverse_proxy beszel-hub:8090
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-Robots-Tag "noindex, nofollow"
    }
}

uptime.{$TAILSCALE_DOMAIN} {
    reverse_proxy uptime-kuma:3001
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}

